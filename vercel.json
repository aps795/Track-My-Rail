{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://track-my-rail.onrender.com/api/$1"
    },
    { "source": "/track-train", "destination": "/track-train.html" },
    { "source": "/train-status", "destination": "/train-status.html" },
    { "source": "/route", "destination": "/route.html" },
    { "source": "/between-stations", "destination": "/between-stations.html" },
    { "source": "/pnr", "destination": "/pnr.html" },
    { "source": "/seat-availability", "destination": "/seat-availability.html" },
    { "source": "/fare-enquiry", "destination": "/fare-enquiry.html" },
    { "source": "/train-details", "destination": "/train-details.html" },
    { "source": "/coach-position", "destination": "/coach-position.html" }
  ]
}
